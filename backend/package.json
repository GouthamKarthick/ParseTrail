{
  "name": "parsetrail-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "tsx src/services/extraction.test.ts",
    "test:spec": "vitest run src/services/extraction.service.spec.ts",
    "eval:fetch": "bash eval/fetch-fixtures.sh",
    "eval:compare": "npx tsx eval/compare.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "mysql2": "^3.14.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
