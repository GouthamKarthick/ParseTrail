# Server
PORT=4000
# Trusted proxy depth (1 = trust the immediate reverse proxy, e.g. Render/Vercel).
TRUST_PROXY=1
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Database
# Compose uses the service name "mysql"; for bare-metal local dev use "localhost".
DB_HOST=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CA_PATH=./ca.pem
# Optional PEM contents; takes precedence over DB_CA_PATH.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# MySQL root password (Docker Compose only, required substitution).
# Used to initialize the root account in the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_DATABASE=parsetrail
MYSQL_USER=parsetrail_user
MYSQL_PASSWORD=change-me-in-production

# Authentication
JWT_SECRET=change-me-please-generate-with-openssl-rand-hex-32
JWT_EXPIRY=1d
COOKIE_SAME_SITE=lax
ALLOW_UNVERIFIED=false
CORS_ORIGINS=http://localhost:5173
RETENTION_DAYS=30

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_TIMEOUT_MS=10000
SMTP_USER=resend
SMTP_PASS=
# Resend requires a verified sending domain for production delivery.
SMTP_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# AI extraction
AI_PROVIDERS=gemini,groq,openrouter
AI_MODEL=gemini-flash-latest
AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_TIMEOUT_MS=20000
LOCAL_LLM_MODEL=Xenova/LaMini-Flan-T5-77M
LOCAL_LLM_ENABLED=true
OCR_MAX_PAGES=3

# Background refinement
REFINE_POLL_MS=15000
REFINE_DAILY_CAP=100
REFINE_MAX_ATTEMPTS=5
REFINE_RATE_PER_MIN=10

# Logging
LOG_LEVEL=debug

# Currency conversion
CURRENCY_CONVERSION_URL=https://api.frankfurter.app
CURRENCY_CONVERSION_FALLBACK_URL=https://open.er-api.com/v6/latest
DISPLAY_CURRENCY=INR
CURRENCY_CONVERSION_CACHE_TTL_MS=300000
CURRENCY_CONVERSION_TIMEOUT_MS=3000
