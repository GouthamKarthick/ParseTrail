# Server
PORT=4000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CA_PATH=./ca.pem
# Optional PEM contents; takes precedence over DB_CA_PATH.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Authentication
JWT_SECRET=change-me-please-generate-with-openssl-rand-hex-32
JWT_EXPIRY=1d
COOKIE_SAME_SITE=lax
ALLOW_UNVERIFIED=false
CORS_ORIGINS=http://localhost:5173
RETENTION_DAYS=30

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# AI extraction
AI_PROVIDER=google
AI_MODEL=gemini-flash-latest
AI_API_KEY=
LOCAL_LLM_MODEL=Xenova/LaMini-Flan-T5-77M

# Background refinement
REFINE_POLL_MS=15000
REFINE_DAILY_CAP=100

# Logging
LOG_LEVEL=debug

# Currency conversion
CURRENCY_CONVERSION_URL=https://api.frankfurter.app
CURRENCY_CONVERSION_FALLBACK_URL=https://open.er-api.com/v6/latest
DISPLAY_CURRENCY=INR
CURRENCY_CONVERSION_CACHE_TTL_MS=300000
CURRENCY_CONVERSION_TIMEOUT_MS=3000
